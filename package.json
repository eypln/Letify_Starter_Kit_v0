{
  "name": "letify-nextjs",
  "version": "2.7.4",
  "private": true,
  "sideEffects": [
    "*.css",
    "*.scss",
    "app/globals.css"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:no-lint": "DISABLE_ESLINT_PLUGIN=true next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "node -e \"require('fs').rmSync('.next', {recursive: true, force: true}); console.log('.next klasörü silindi')\"",
    "analyze": "ANALYZE=true npm run build",
    "analyze:browser": "ANALYZE=true npm run build && open .next/analyze/client.html",
    "lighthouse:all": "node scripts/lighthouse-all.js",
    "test": "jest",
    "backup": "tsx scripts/backup-database.ts",
    "backup:list": "dir /B backups",
    "restore": "tsx scripts/restore-database.ts",
    "restore:latest": "for /f %i in ('dir /b /od backups\\backup-*.json') do set LATEST=%i && tsx scripts/restore-database.ts backups\\%LATEST%",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:unit": "jest __tests__/lib",
    "test:components": "jest __tests__/components",
    "test:api": "jest __tests__/api",
    "test:integration": "jest __tests__/integration",
    "test-credit-purchase": "npx ts-node scripts/test-credit-purchase.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.39.3",
    "@tanstack/react-query": "^5.90.2",
    "@vercel/analytics": "^1.6.1",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "country-list": "^2.4.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.556.0",
    "next": "16.0.7",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.9",
    "react": "19.2.1",
    "react-datepicker": "^8.7.0",
    "react-dom": "19.2.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.50.1",
    "react-select": "^5.10.2",
    "recharts": "^3.2.1",
    "sonner": "^2.0.7",
    "stripe": "^18.5.0",
    "tailwind-merge": "^2.2.1",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/bundle-analyzer": "^16.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/country-list": "^2.1.4",
    "@types/google.maps": "^3.55.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.3",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.9.19",
    "caniuse-lite": "^1.0.30001770",
    "critters": "^0.0.23",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "eslint-plugin-react-hooks": "6.0.0-rc.2",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "mini-css-extract-plugin": "^2.9.4",
    "next-pwa": "^5.6.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "web-push": "^3.6.7"
  },
  "packageManager": "pnpm@10.30.0+sha512.2b5753de015d480eeb88f5b5b61e0051f05b4301808a82ec8b840c9d2adf7748eb352c83f5c1593ca703ff1017295bc3fdd3119abb9686efc96b9fcb18200937"
}
